{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "warthunderlocalhostoverlay",
  "version": "0.1.11",
  "identifier": "fun.ivdamke.warthunderlocalhostoverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "War Thunder Desktop Assistant",
        "width": 1000,
        "height": 650,
        "minWidth": 360,
        "minHeight": 240,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
